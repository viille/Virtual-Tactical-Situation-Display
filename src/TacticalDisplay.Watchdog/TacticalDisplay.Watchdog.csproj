<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyTitle>VTSD</AssemblyTitle>
    <Product>VTSD</Product>
    <Company>Virtual Tactical Situation Display</Company>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TacticalDisplay.Watchdog</AssemblyName>
    <Version>0.8.6</Version>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\TacticalDisplay.App\Services\WindowsAppIdentity.cs" Link="WindowsAppIdentity.cs" />
  </ItemGroup>
</Project>
