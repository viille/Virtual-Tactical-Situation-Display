<Window x:Class="VTSD.LocalAarFuelTester.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VTSD Local AAR Fuel Tester"
        Width="560" Height="520" MinWidth="520" MinHeight="470"
        WindowStartupLocation="CenterScreen"
        Background="#10191E" Foreground="#D9F2EC">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="LOCAL BRIDGE TEST" Foreground="#9AFAD7" FontSize="18" FontWeight="Bold" />
            <TextBlock Text="Sends fuel read/write requests directly to the installed VTSD WASM bridge. Simulator fuel will change when you apply a test." TextWrapping="Wrap" Margin="0,6,0,10" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox x:Name="SimConnectPathBox" Height="30" VerticalContentAlignment="Center" />
            <Button x:Name="ConnectButton" Grid.Column="1" Content="CONNECT / RECHECK" Click="OnConnectClick" Margin="8,0,0,0" Padding="10,4" />
        </Grid>
        <Border Grid.Row="2" Background="#18252B" BorderBrush="#355A56" BorderThickness="1" Padding="10" Margin="0,0,0,10">
            <TextBlock x:Name="StatusText" Text="Not connected" TextWrapping="Wrap" />
        </Border>
        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="92" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="100" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Text="Fuel (kg)" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="AmountBox" Grid.Column="1" Text="100" Height="30" VerticalContentAlignment="Center" />
            <TextBlock Grid.Column="2" Text="over (sec)" VerticalAlignment="Center" Margin="12,0,8,0" />
            <TextBox x:Name="DurationBox" Grid.Column="3" Text="60" Width="62" Height="30" VerticalContentAlignment="Center" />
            <Button x:Name="AddButton" Grid.Column="4" Content="ADD FUEL" Click="OnAddClick" Margin="8,0,0,0" Padding="10,4" IsEnabled="False" />
            <Button x:Name="RemoveButton" Grid.Column="5" Content="REMOVE" Click="OnRemoveClick" Margin="8,0,0,0" Padding="10,4" HorizontalAlignment="Left" IsEnabled="False" />
            <Button x:Name="StopButton" Grid.Column="6" Content="STOP" Click="OnStopClick" Margin="8,0,0,0" Padding="10,4" HorizontalAlignment="Left" IsEnabled="False" />
        </Grid>
        <ProgressBar x:Name="TransferProgress" Grid.Row="4" Height="14" Margin="0,0,0,8" Minimum="0" Maximum="100" Visibility="Collapsed" />
        <Border Grid.Row="5" Background="#0B1114" BorderBrush="#283843" BorderThickness="1" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="LogText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0" Background="Transparent" Foreground="#9AFAD7" VerticalScrollBarVisibility="Disabled" />
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
